# ==========================================
# GOOGLE CALENDAR API INTEGRATION
# ==========================================
# Follow instructions in GOOGLE_CALENDAR_SETUP.md to obtain these credentials.

# 1. Google Calendar ID (e.g. primary or your specific salon calendar ID)
GOOGLE_CALENDAR_ID="your-mosphere-calendar-id@group.calendar.google.com"

# 2. Service Account Client Email
GOOGLE_SERVICE_ACCOUNT_EMAIL="mosphere-calendar-bot@your-gcp-project.iam.gserviceaccount.com"

# 3. Service Account Private Key (Keep the quotes, include -----BEGIN PRIVATE KEY----- and \n for line breaks)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ALTERNATIVE: Path to downloaded Service Account JSON credentials file
# GOOGLE_KEY_FILE_PATH="./service-account-key.json"
